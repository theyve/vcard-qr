# Netlify subdomain → canonical domain. Keep before all path rules.
https://vcard-qr.netlify.app/   https://vcardqr.ch/de/      301!
http://vcard-qr.netlify.app/    https://vcardqr.ch/de/      301!
https://vcard-qr.netlify.app/*  https://vcardqr.ch/:splat  301!
http://vcard-qr.netlify.app/*   https://vcardqr.ch/:splat  301!

/sitemap.xml   /sitemap.xml   200!
/robots.txt    /robots.txt    200!

# Root locale redirect (German default). Force so index.html does not shadow this.
/              /de/           302!
/              /de/           302! Language=de
/              /en/           302! Language=en

# Wrong-language slugs → canonical locale URL
/en/was-ist-vcard           /en/what-is-vcard/          301
/en/was-ist-vcard/          /en/what-is-vcard/          301
/de/what-is-vcard           /de/was-ist-vcard/          301
/de/what-is-vcard/          /de/was-ist-vcard/          301

# Wrong-language business-card slugs → canonical locale URL
/en/qr-code-visitenkarte    /en/business-card-qr-code/  301
/en/qr-code-visitenkarte/   /en/business-card-qr-code/  301
/de/business-card-qr-code   /de/qr-code-visitenkarte/   301
/de/business-card-qr-code/  /de/qr-code-visitenkarte/   301

# Unknown URLs: real 404, not a soft-200 generator page
/*             /404.html      404
