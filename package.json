{
  "name": "vcard-qr",
  "version": "1.0.0",
  "description": "Free and open-source privacy-friendly vCard QR code generator. Create QR codes for contact details directly in the browser.",
  "keywords": [
    "vcard",
    "qr",
    "qrcode",
    "contact",
    "privacy"
  ],
  "license": "MIT",
  "author": "theyve",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nuintun/qrcode": "^5.0.3",
    "qr-code-styling": "^1.9.2",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@babel/plugin-bugfix-firefox-class-in-computed-class-key": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.10.1",
    "@vite-pwa/sveltekit": "^1.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.5.1",
    "globals": "^16.5.0",
    "svelte": "^5.28.2",
    "svelte-check": "^4.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.2.0"
  }
}
